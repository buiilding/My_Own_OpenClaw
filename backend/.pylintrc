[MASTER]
# Specify a configuration file. Default: None
# pylint --rcfile=.pylintrc

[MESSAGES CONTROL]
# Disable the message, report, category or checker with the given id(s).
# You can either pass a comma separated list of message ids, or add them on
# separate lines with the --disable option (useful from a configuration file).
# Globally disabling a message is discouraged. Instead, attempt to disable
# messages only where they are not relevant.
disable=
    C0114, # Missing module docstring
    C0115, # Missing class docstring
    C0116, # Missing function or method docstring
    R0903, # Too few public methods
    R0902, # Too many instance attributes
    W0613, # Unused argument
    W0511, # Fixme / Todo

[FORMAT]
# Maximum number of characters on a line (excluding the newline character).
max-line-length=88

[TYPECHECK]
# List of members which are set dynamically and missed by pylint inference
# system, and so shouldn't raise no-member or similar messages.
# Example: C{db.session.query(Foo).method()}.
# dynamic-attributes=

[DESIGN]
# Maximum number of arguments for function / method.
max-args=7

# Maximum number of locals for function / method body.
max-locals=20

# Maximum number of statements in function / method body.
max-statements=70

# Maximum number of branches in function / method body.
max-branches=12

# Maximum number of return statements in function / method body.
max-returns=6

# Maximum number of public methods for a class (see R0904 for more details).
max-public-methods=20

# Maximum number of attributes for a class (see R0902 for more details).
max-attributes=7

# Minimum number of public methods for a class (see R0903 for more details).
min-public-methods=2

# Regular expression for constants (UPPER_SNAKE_CASE).
const-rgx=([A-Z_][A-Z0-9_]{2,30})$

[MISCELLANEOUS]
# List of note tags to take into account, separated by a comma.
notes=FIXME,XXX,TODO
