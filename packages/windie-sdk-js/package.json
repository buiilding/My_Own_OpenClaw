{
  "name": "@windie/sdk",
  "version": "0.1.0",
  "description": "Public TypeScript SDK for waking Windie agents and routing local runtime tools.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "windie",
    "windieos",
    "agents",
    "desktop-agents",
    "computer-use"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
