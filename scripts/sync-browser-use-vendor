#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

SOURCE_DIR="${1:-${REPO_ROOT}/../browser-use/browser_use}"
DEST_DIR="${REPO_ROOT}/frontend/src/main/python/tools/browser/browser_use"
MANIFEST_PATH="${REPO_ROOT}/frontend/src/main/python/tools/browser/browser_use_vendor_manifest.json"
PRUNED_DIRS=(
  "skill_cli"
  "mcp"
  "actor/playground"
  "dom/playground"
  "llm/tests"
  "tokens/tests"
  "agent/system_prompts"
  "code_use"
  "controller"
  "integrations"
  "llm/anthropic"
  "llm/aws"
  "llm/deepseek"
  "llm/groq"
  "llm/ollama"
  "llm/openrouter"
  "llm/vercel"
  "sandbox"
  "screenshots"
  "skills"
  "agent/cloud_events.py"
  "agent/gif.py"
  "agent/judge.py"
  "agent/prompts.py"
  "agent/service.py"
  "agent/variable_detector.py"
  "agent/message_manager/service.py"
  "agent/message_manager/utils.py"
  "browser/python_highlights.py"
  "browser/watchdogs/crash_watchdog.py"
  "dom/serializer/code_use_serializer.py"
  "tokens/custom_pricing.py"
  "tokens/mappings.py"
  "tokens/service.py"
  "README.md"
  "actor/README.md"
  "llm/README.md"
  "llm/oci_raw/README.md"
  "py.typed"
  "cli.py"
  "init_cmd.py"
  "exceptions.py"
)
RSYNC_EXCLUDES=(
  "__pycache__"
  "*.pyc"
  "skill_cli/"
  "mcp/"
  "actor/playground/"
  "dom/playground/"
  "llm/tests/"
  "tokens/tests/"
  "agent/system_prompts/"
  "code_use/"
  "controller/"
  "integrations/"
  "llm/anthropic/"
  "llm/aws/"
  "llm/deepseek/"
  "llm/groq/"
  "llm/ollama/"
  "llm/openrouter/"
  "llm/vercel/"
  "sandbox/"
  "screenshots/"
  "skills/"
  "agent/cloud_events.py"
  "agent/gif.py"
  "agent/judge.py"
  "agent/prompts.py"
  "agent/service.py"
  "agent/variable_detector.py"
  "agent/message_manager/service.py"
  "agent/message_manager/utils.py"
  "browser/python_highlights.py"
  "browser/watchdogs/crash_watchdog.py"
  "dom/serializer/code_use_serializer.py"
  "tokens/custom_pricing.py"
  "tokens/mappings.py"
  "tokens/service.py"
  "/README.md"
  "actor/README.md"
  "llm/README.md"
  "llm/oci_raw/README.md"
  "/py.typed"
  "/cli.py"
  "/init_cmd.py"
  "/exceptions.py"
)

if [[ ! -d "${SOURCE_DIR}" ]]; then
  echo "Source directory not found: ${SOURCE_DIR}" >&2
  echo "Usage: scripts/sync-browser-use-vendor [path-to-browser_use-source-dir]" >&2
  exit 1
fi

mkdir -p "${DEST_DIR}"

RSYNC_ARGS=( -a --delete --delete-excluded )
for pattern in "${RSYNC_EXCLUDES[@]}"; do
  RSYNC_ARGS+=( "--exclude=${pattern}" )
done

rsync "${RSYNC_ARGS[@]}" "${SOURCE_DIR}/" "${DEST_DIR}/"

VERIFY_ARGS=( -a --delete --delete-excluded --dry-run --itemize-changes )
for pattern in "${RSYNC_EXCLUDES[@]}"; do
  VERIFY_ARGS+=( "--exclude=${pattern}" )
done
VERIFY_OUTPUT="$(rsync "${VERIFY_ARGS[@]}" "${SOURCE_DIR}/" "${DEST_DIR}/")"
if [[ -n "${VERIFY_OUTPUT}" ]]; then
  echo "Vendor sync verification failed: destination differs from source." >&2
  exit 1
fi

for relative_path in "${PRUNED_DIRS[@]}"; do
  if [[ -e "${DEST_DIR}/${relative_path}" ]]; then
    echo "Vendor sync pruning failed: ${DEST_DIR}/${relative_path} still exists." >&2
    exit 1
  fi
done

SOURCE_REPO_ROOT="$(cd "${SOURCE_DIR}/.." && pwd)"
SOURCE_COMMIT="unknown"
if git -C "${SOURCE_REPO_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  SOURCE_COMMIT="$(git -C "${SOURCE_REPO_ROOT}" rev-parse HEAD)"
fi

SYNCED_AT_UTC="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

cat > "${MANIFEST_PATH}" <<MANIFEST
{
  "source_repo": "${SOURCE_REPO_ROOT}",
  "source_subdir": "browser_use",
  "source_commit": "${SOURCE_COMMIT}",
  "synced_at_utc": "${SYNCED_AT_UTC}",
  "pruned_paths": [
    "skill_cli",
    "mcp",
    "actor/playground",
    "dom/playground",
    "llm/tests",
    "tokens/tests",
    "agent/system_prompts",
    "code_use",
    "controller",
    "integrations",
    "llm/anthropic",
    "llm/aws",
    "llm/deepseek",
    "llm/groq",
    "llm/ollama",
    "llm/openrouter",
    "llm/vercel",
    "sandbox",
    "screenshots",
    "skills",
    "agent/cloud_events.py",
    "agent/gif.py",
    "agent/judge.py",
    "agent/prompts.py",
    "agent/service.py",
    "agent/variable_detector.py",
    "agent/message_manager/service.py",
    "agent/message_manager/utils.py",
    "browser/python_highlights.py",
    "browser/watchdogs/crash_watchdog.py",
    "dom/serializer/code_use_serializer.py",
    "tokens/custom_pricing.py",
    "tokens/mappings.py",
    "tokens/service.py",
    "README.md",
    "actor/README.md",
    "llm/README.md",
    "llm/oci_raw/README.md",
    "py.typed",
    "cli.py",
    "init_cmd.py",
    "exceptions.py"
  ]
}
MANIFEST

echo "Synced Browser Use vendor tree"
echo "  source: ${SOURCE_DIR}"
echo "  dest:   ${DEST_DIR}"
echo "  commit: ${SOURCE_COMMIT}"
