#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

SOURCE_DIR="${1:-${REPO_ROOT}/../browser-use/browser_use}"
VENDORED_DIR="${REPO_ROOT}/frontend/src/main/python/tools/browser/browser_use"
REQ_FILE="${REPO_ROOT}/frontend/src/main/python/requirements.txt"
REQ_RUNTIME_FILE="${REPO_ROOT}/frontend/src/main/python/requirements.runtime.txt"
PRUNED_DIRS=(
  "skill_cli"
  "mcp"
  "actor/playground"
  "dom/playground"
  "llm/tests"
  "tokens/tests"
  "agent/system_prompts"
  "code_use"
  "controller"
  "integrations"
  "browser/cloud"
  "sync"
  "telemetry"
  "llm/anthropic"
  "llm/aws"
  "llm/deepseek"
  "llm/groq"
  "llm/ollama"
  "llm/openrouter"
  "llm/vercel"
  "sandbox"
  "screenshots"
  "skills"
  "agent/cloud_events.py"
  "agent/gif.py"
  "agent/judge.py"
  "agent/prompts.py"
  "agent/service.py"
  "agent/variable_detector.py"
  "agent/message_manager/service.py"
  "agent/message_manager/utils.py"
  "browser/python_highlights.py"
  "browser/watchdogs/crash_watchdog.py"
  "dom/serializer/code_use_serializer.py"
  "tokens/custom_pricing.py"
  "tokens/mappings.py"
  "tokens/service.py"
  "README.md"
  "actor/README.md"
  "llm/README.md"
  "llm/oci_raw/README.md"
  "py.typed"
  "cli.py"
  "init_cmd.py"
  "exceptions.py"
)
RSYNC_EXCLUDES=(
  "__pycache__"
  "*.pyc"
  "skill_cli/"
  "mcp/"
  "actor/playground/"
  "dom/playground/"
  "llm/tests/"
  "tokens/tests/"
  "agent/system_prompts/"
  "code_use/"
  "controller/"
  "integrations/"
  "browser/cloud/"
  "sync/"
  "telemetry/"
  "llm/anthropic/"
  "llm/aws/"
  "llm/deepseek/"
  "llm/groq/"
  "llm/ollama/"
  "llm/openrouter/"
  "llm/vercel/"
  "sandbox/"
  "screenshots/"
  "skills/"
  "agent/cloud_events.py"
  "agent/gif.py"
  "agent/judge.py"
  "agent/prompts.py"
  "agent/service.py"
  "agent/variable_detector.py"
  "agent/message_manager/service.py"
  "agent/message_manager/utils.py"
  "browser/python_highlights.py"
  "browser/watchdogs/crash_watchdog.py"
  "dom/serializer/code_use_serializer.py"
  "tokens/custom_pricing.py"
  "tokens/mappings.py"
  "tokens/service.py"
  "browser/profile.py"
  "browser/session.py"
  "tools/registry/service.py"
  "/README.md"
  "actor/README.md"
  "llm/README.md"
  "llm/oci_raw/README.md"
  "/py.typed"
  "/cli.py"
  "/init_cmd.py"
  "/exceptions.py"
)
RSYNC_PROTECTED=(
  "browser/profile.py"
  "browser/session.py"
  "tools/registry/service.py"
)

if [[ ! -d "${VENDORED_DIR}" ]]; then
  echo "Vendored Browser Use directory missing: ${VENDORED_DIR}" >&2
  exit 1
fi

if [[ ! -d "${SOURCE_DIR}" ]]; then
  echo "Source Browser Use directory missing: ${SOURCE_DIR}" >&2
  echo "Usage: scripts/check-browser-use-vendor [path-to-browser_use-source-dir]" >&2
  exit 1
fi

# Remove runtime-generated cache artifacts before parity diff so checks fail
# only on source drift (not local bytecode noise from test runs).
VENDORED_DIR_ENV="${VENDORED_DIR}" python - <<'PY'
import os
from pathlib import Path
import shutil

root = Path(os.environ["VENDORED_DIR_ENV"])
for pycache_dir in root.rglob("__pycache__"):
    if pycache_dir.is_dir():
        shutil.rmtree(pycache_dir, ignore_errors=True)
for pyc_file in root.rglob("*.pyc"):
    if pyc_file.is_file():
        pyc_file.unlink(missing_ok=True)
PY

VERIFY_ARGS=( -a -O --delete --delete-excluded --dry-run --itemize-changes )
for pattern in "${RSYNC_EXCLUDES[@]}"; do
  VERIFY_ARGS+=( "--exclude=${pattern}" )
done
for pattern in "${RSYNC_PROTECTED[@]}"; do
  VERIFY_ARGS+=( "--filter=P ${pattern}" )
done
VERIFY_OUTPUT="$(rsync "${VERIFY_ARGS[@]}" "${SOURCE_DIR}/" "${VENDORED_DIR}/")"
if [[ -n "${VERIFY_OUTPUT}" ]]; then
  echo "Vendored Browser Use tree is out of sync with source." >&2
  echo "Run: ./scripts/sync-browser-use-vendor" >&2
  exit 1
fi

for relative_path in "${PRUNED_DIRS[@]}"; do
  if [[ -e "${VENDORED_DIR}/${relative_path}" ]]; then
    echo "Vendored Browser Use includes pruned path: ${VENDORED_DIR}/${relative_path}" >&2
    echo "Run: ./scripts/sync-browser-use-vendor" >&2
    exit 1
  fi
done

if grep -Eq '^[[:space:]]*browser-use([<>=!~].*)?$' "${REQ_FILE}" "${REQ_RUNTIME_FILE}"; then
  echo "browser-use pip package must not be listed in sidecar requirements." >&2
  echo "Use vendored frontend/src/main/python/tools/browser/browser_use instead." >&2
  exit 1
fi

IMPORT_PATH="$(${REPO_ROOT}/scripts/python-in-env sidecar bash -lc '
  cd "'"${REPO_ROOT}"'"/frontend/src/main/python
  python - <<"PY"
from tools.browser.browser_tool import _ensure_vendored_browser_use_on_path
_ensure_vendored_browser_use_on_path()
import browser_use
print(browser_use.__file__)
PY
')"

EXPECTED_PREFIX="${VENDORED_DIR}/"
if [[ "${IMPORT_PATH}" != ${EXPECTED_PREFIX}* ]]; then
  echo "browser_use import does not resolve to vendored path." >&2
  echo "Resolved: ${IMPORT_PATH}" >&2
  echo "Expected prefix: ${EXPECTED_PREFIX}" >&2
  exit 1
fi

echo "Browser Use vendor check passed"
echo "  source:  ${SOURCE_DIR}"
echo "  vendor:  ${VENDORED_DIR}"
echo "  import:  ${IMPORT_PATH}"
