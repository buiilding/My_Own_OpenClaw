#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FRONTEND_DIR="${ROOT_DIR}/frontend"
RUNTIME_DIR="${FRONTEND_DIR}/python-runtime"
RUNTIME_ARCHIVE="${FRONTEND_DIR}/python-runtime.tar.gz"
RUNTIME_REQS_CORE="${FRONTEND_DIR}/src/main/python/requirements.runtime.core.txt"
RUNTIME_REQS_BROWSER="${FRONTEND_DIR}/src/main/python/requirements.runtime.browser.txt"
RUNTIME_REQS_FULL="${FRONTEND_DIR}/src/main/python/requirements.runtime.txt"
MODE="${WINDIE_SIDECAR_RUNTIME_MODE:-slim}"
PROFILE="${WINDIE_SIDECAR_RUNTIME_PROFILE:-core}"
SOURCE_MODE="${WINDIE_SIDECAR_SOURCE_MODE:-sourceless}"
INCLUDE_BROWSER_PACK=0

if [[ ! -f "${RUNTIME_REQS_CORE}" ]]; then
  echo "[build-sidecar-runtime] Missing runtime requirements file: ${RUNTIME_REQS_CORE}" >&2
  exit 1
fi

if [[ ! -f "${RUNTIME_REQS_BROWSER}" ]]; then
  echo "[build-sidecar-runtime] Missing runtime browser requirements file: ${RUNTIME_REQS_BROWSER}" >&2
  exit 1
fi

if [[ ! -f "${RUNTIME_REQS_FULL}" ]]; then
  echo "[build-sidecar-runtime] Missing runtime full requirements file: ${RUNTIME_REQS_FULL}" >&2
  exit 1
fi

if [[ -n "${WINDIE_PYTHON_BUILD:-}" ]]; then
  BASE_PYTHON="${WINDIE_PYTHON_BUILD}"
elif command -v python3 >/dev/null 2>&1; then
  BASE_PYTHON="python3"
elif command -v python >/dev/null 2>&1; then
  BASE_PYTHON="python"
else
  echo "[build-sidecar-runtime] Could not find python3/python on PATH." >&2
  exit 1
fi

echo "[build-sidecar-runtime] mode=${MODE}"
echo "[build-sidecar-runtime] profile=${PROFILE}"
echo "[build-sidecar-runtime] source_mode=${SOURCE_MODE}"
echo "[build-sidecar-runtime] python=${BASE_PYTHON}"
echo "[build-sidecar-runtime] runtime=${RUNTIME_DIR}"

rm -rf "${RUNTIME_DIR}"
"${BASE_PYTHON}" -m venv "${RUNTIME_DIR}"

if [[ -x "${RUNTIME_DIR}/bin/python" ]]; then
  RUNTIME_PYTHON="${RUNTIME_DIR}/bin/python"
elif [[ -x "${RUNTIME_DIR}/Scripts/python.exe" ]]; then
  RUNTIME_PYTHON="${RUNTIME_DIR}/Scripts/python.exe"
else
  echo "[build-sidecar-runtime] Could not resolve runtime python executable." >&2
  exit 1
fi

"${RUNTIME_PYTHON}" -m pip install --upgrade pip setuptools wheel

case "${PROFILE}" in
  core)
    INCLUDE_BROWSER_PACK=0
    ;;
  core+browser|browser|full)
    INCLUDE_BROWSER_PACK=1
    ;;
  *)
    echo "[build-sidecar-runtime] Unsupported WINDIE_SIDECAR_RUNTIME_PROFILE=${PROFILE}" >&2
    echo "[build-sidecar-runtime] Supported values: core, core+browser, full" >&2
    exit 1
    ;;
esac

"${RUNTIME_PYTHON}" -m pip install -r "${RUNTIME_REQS_CORE}"
if [[ "${INCLUDE_BROWSER_PACK}" -eq 1 ]]; then
  "${RUNTIME_PYTHON}" -m pip install -r "${RUNTIME_REQS_BROWSER}"
fi

echo "[build-sidecar-runtime] prefetching wakeword model assets (best effort)"
if ! "${RUNTIME_PYTHON}" - <<'PY'
import importlib
import inspect
import pathlib
import sys

try:
    openwakeword_mod = importlib.import_module("openwakeword")
    utils_mod = importlib.import_module("openwakeword.utils")
except Exception as exc:
    print(f"[build-sidecar-runtime] wakeword prefetch skipped (import failed): {exc}", file=sys.stderr)
    raise SystemExit(0)

download_models = getattr(utils_mod, "download_models", None)
if not callable(download_models):
    print("[build-sidecar-runtime] wakeword prefetch skipped (download_models unavailable)", file=sys.stderr)
    raise SystemExit(0)

target_dir = pathlib.Path(openwakeword_mod.__file__).resolve().parent / "resources" / "models"
target_dir.mkdir(parents=True, exist_ok=True)
download_params = inspect.signature(download_models).parameters

if "target_directory" in download_params:
    download_models(["hey_jarvis"], target_directory=str(target_dir))
else:
    download_models(["hey_jarvis"])

print(f"[build-sidecar-runtime] wakeword models prefetched to {target_dir}", file=sys.stderr)
PY
then
  echo "[build-sidecar-runtime] wakeword prefetch completed"
else
  echo "[build-sidecar-runtime] WARNING: wakeword prefetch failed; runtime will fall back to user cache download"
fi

if [[ "${MODE}" == "full" ]]; then
  echo "[build-sidecar-runtime] installing playwright browser payload (full mode)"
  PLAYWRIGHT_BROWSERS_PATH="${RUNTIME_DIR}/ms-playwright" \
    "${RUNTIME_PYTHON}" -m playwright install chromium
else
  echo "[build-sidecar-runtime] skipping playwright browser payload (slim mode)"
fi

# Copy WindieOS sidecar source into runtime so packaged app can execute from
# resources/python-runtime/sidecar without shipping plaintext app.asar sources.
SIDECAR_SRC_DIR="${FRONTEND_DIR}/src/main/python"
SIDECAR_DST_DIR="${RUNTIME_DIR}/sidecar"
mkdir -p "${SIDECAR_DST_DIR}"
cp -R "${SIDECAR_SRC_DIR}/." "${SIDECAR_DST_DIR}/"

if [[ "${SOURCE_MODE}" == "sourceless" ]]; then
  echo "[build-sidecar-runtime] compiling sidecar to sourceless bytecode"
  "${RUNTIME_PYTHON}" -m compileall -q -b "${SIDECAR_DST_DIR}"
  find "${SIDECAR_DST_DIR}" -type f -name "*.py" -delete
elif [[ "${SOURCE_MODE}" != "source" ]]; then
  echo "[build-sidecar-runtime] Unsupported WINDIE_SIDECAR_SOURCE_MODE=${SOURCE_MODE}" >&2
  echo "[build-sidecar-runtime] Supported values: sourceless, source" >&2
  exit 1
fi

# Shrink package output by removing transient bytecode caches.
find "${RUNTIME_DIR}" -type d -name "__pycache__" -prune -exec rm -rf {} +
if [[ "${SOURCE_MODE}" == "sourceless" ]]; then
  find "${RUNTIME_DIR}" -type f -name "*.pyc" ! -path "${SIDECAR_DST_DIR}/*" -delete
else
  find "${RUNTIME_DIR}" -type f -name "*.pyc" -delete
fi

rm -f "${RUNTIME_ARCHIVE}"
tar -C "${FRONTEND_DIR}" -czf "${RUNTIME_ARCHIVE}" "python-runtime"

echo "[build-sidecar-runtime] wrote ${RUNTIME_ARCHIVE}"
