#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

python3 "$ROOT/bin/docs-list"

(
  cd "$ROOT"
  python -m pytest
)

if [ -d "$ROOT/frontend" ]; then
  if [ -d "$ROOT/frontend/node_modules" ]; then
    (
      cd "$ROOT/frontend"
      npm run lint
      npm run test:ci
    )
  else
    echo "Skipping frontend checks (frontend/node_modules missing)."
  fi
fi
